PORT=5000
DB_USER=postgres
DB_HOST=localhost
DB_NAME=ats_db
DB_PASSWORD=your_postgres_password
DB_PORT=5432
JWT_SECRET=your_jwt_secret_at_least_32_chars_long

# --- Email (optional) ---
# When SMTP_HOST, SMTP_USER, and SMTP_PASS are all set, the API sends:
#   - a confirmation email when an applicant submits an application (POST /applications)
#   - an update email when an admin changes status (PATCH /admin/applications/:id/status)
# If SMTP is not configured, those steps are skipped (API still returns 200/201).
#
# MAIL_FROM = visible "From" address; if unset, SMTP_USER is used.
# SMTP_PORT=587
# SMTP_SECURE=false   # use true for port 465 (SSL)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
