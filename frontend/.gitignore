.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Misc
.DS_Store
Thumbs.db
*.pem

# Debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

